# Default: ignore everything in the repository tree.
*

# Keep directories traversable so nested allow-rules can work.
!*/

# Keep git control files.
!.gitignore
!.gitattributes

# Keep MATLAB source and Markdown documentation.
!*.m
!*.md
!scripts/validation/postprocess_pe_bellhop_pm_model_discrepancy_statistics.py

# Retired local artifacts: override ALL allow-rules above, including .m/.md.
/cash/

# Bellhop 2020 validation-only source overlays and reproducibility evidence.
!/scripts/validation/support/bellhop_internal_flat_wall_poc/*.f90
!/scripts/validation/support/bellhop_internal_flat_wall_poc/*.ps1
!/scripts/validation/support/bellhop_internal_tilted_wall_poc/*.f90
!/scripts/validation/support/bellhop_internal_tilted_wall_poc/*.ps1
!/scripts/validation/support/bellhop_internal_sinusoidal_wall_poc/*.f90
!/scripts/validation/support/bellhop_internal_sinusoidal_wall_poc/*.ps1
!/scripts/validation/support/bellhop_internal_pm_wall_poc/*.f90
!/scripts/validation/support/bellhop_internal_pm_wall_poc/*.ps1
!/results/validation/bellhop_internal_flat_wall_poc/*.csv
!/results/validation/bellhop_internal_flat_wall_poc/*.json
!/results/validation/bellhop_internal_tilted_wall_poc/*.csv
!/results/validation/bellhop_internal_tilted_wall_poc/*.json
!/results/validation/bellhop_internal_sinusoidal_wall_poc/*.csv
!/results/validation/bellhop_internal_sinusoidal_wall_poc/*.json
!/results/validation/bellhop_internal_pm_wall_poc/*.csv
!/results/validation/bellhop_internal_pm_wall_poc/*.json
!/results/validation/bellhop_curved_wall_beam_frame_audit/*.csv
!/results/validation/bellhop_curved_wall_beam_frame_audit/*.json
!/results/validation/bellhop_internal_vertical_tangent_poc/*.csv
!/results/validation/bellhop_internal_vertical_tangent_poc/*.json
