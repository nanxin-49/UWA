# Default: ignore everything in the repository tree.
*

# Keep directories traversable so nested allow-rules can work.
!*/

# Keep git control files.
!.gitignore
!.gitattributes

# Keep MATLAB source and Markdown documentation.
!*.m
!*.md
!scripts/validation/postprocess_pe_bellhop_pm_model_discrepancy_statistics.py

# Re-generable build, compiler, toolchain, and Python cache content must stay
# ignored even though the repository-wide source/documentation rules above
# allow .m and .md files.
**/build/
**/build/**
**/toolchain_tmp/
**/toolchain_tmp/**
**/bin/
**/bin/**
**/__pycache__/
**/__pycache__/**
**/.cache/
**/.cache/**
*.pyc
*.pyo

# Retired local artifacts: override ALL allow-rules above, including .m/.md.
/cash/

# Bellhop 2020 validation-only source overlays and reproducibility evidence.
!/scripts/validation/support/bellhop_internal_flat_wall_poc/*.f90
